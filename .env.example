# Copy to .env.local for local development, and set the same variables in your
# hosting provider for production. Never commit real values.

# Public URL of the website, used for canonical URLs, the sitemap and social
# previews. Example: https://www.your-domain.co.tz
NEXT_PUBLIC_SITE_URL=

# Contact form delivery through Resend (https://resend.com).
# Until all three are set, the form tells visitors their message was NOT sent
# and offers email/phone instead.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "PRO-INTEQ Website <website@your-domain.co.tz>"
CONTACT_FROM_EMAIL=
