# Copy to .env.local for local development, and set the same variables in your
# hosting provider for production. Never commit real values.

# Public URL of the website, used for canonical URLs, the sitemap and social
# previews. Example: https://www.your-domain.co.tz
NEXT_PUBLIC_SITE_URL=

# Quote / contact form delivery through Resend (https://resend.com).
# These are server-only: never prefix them with NEXT_PUBLIC_.
# Until all three are set, the form tells visitors their request was NOT sent
# and offers email/phone instead.
#
# API key from Resend → API Keys (starts with "re_").
RESEND_API_KEY=
# Inbox that receives quote requests (comma-separate for several).
CONTACT_TO_EMAIL=prointeq.engineering@gmail.com
# Sender on a domain verified in Resend → Domains, e.g.
#   PRO-INTEQ Website <website@your-domain.co.tz>
# For a quick test before the domain is verified, Resend allows
#   onboarding@resend.dev — but only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
